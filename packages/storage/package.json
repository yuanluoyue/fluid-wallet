{
  "name": "@fluid-wallet/storage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first data layer for Fluid Wallet: Dexie/IndexedDB schema for providers, connections, sessions and logs.",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fluid-wallet/crypto": "workspace:^",
    "@fluid-wallet/protocol": "workspace:^",
    "dexie": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
