{
  "name": "@fluid-wallet/ai-sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "Vercel AI SDK adapter for Fluid Wallet: a ChatTransport backed by a Fluid Wallet client.",
  "keywords": ["fluid-wallet", "ai-sdk", "vercel-ai", "llm", "transport"],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fluid-wallet/sdk": "workspace:^"
  },
  "peerDependencies": {
    "ai": "^7.0.0"
  },
  "devDependencies": {
    "@fluid-wallet/test-kit": "workspace:^",
    "ai": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
